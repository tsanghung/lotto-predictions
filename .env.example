LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_USER_ID=your_user_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# AI 模型（可選，預設皆為 Gemma 4 31B）
GEMINI_MODEL_PREDICTION=gemma-4-31b-it
GEMINI_MODEL_ATTRIBUTION=gemma-4-31b-it

# Supabase backend sync
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend public Supabase read-only config
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Cloudflare Pages deploy
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_pages_api_token_here
CLOUDFLARE_PROJECT_NAME=lotto-predictions
